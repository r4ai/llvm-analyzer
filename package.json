{
  "name": "llvm-analyzer",
  "version": "0.0.0",
  "private": true,
  "description": "LLVM IR language support for VSCode (syntax highlighting; LSP features in progress).",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "typecheck": "pnpm -r --if-present typecheck",
    "pin-actions": "pinact run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0"
}
