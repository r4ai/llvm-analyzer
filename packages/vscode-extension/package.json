{
  "name": "llvm-analyzer-vscode",
  "displayName": "LLVM IR Analyzer",
  "version": "0.1.7",
  "description": "LLVM IR language support with syntax highlighting and LSP features.",
  "categories": [
    "Programming Languages"
  ],
  "homepage": "https://github.com/r4ai/llvm-analyzer#readme",
  "bugs": {
    "url": "https://github.com/r4ai/llvm-analyzer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r4ai/llvm-analyzer.git",
    "directory": "packages/vscode-extension"
  },
  "publisher": "r4ai",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --out llvm-analyzer-vscode.vsix",
    "test:e2e": "pnpm build && node test/runTest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@llvm-analyzer/analyzer": "workspace:*",
    "@llvm-analyzer/language-server": "workspace:*",
    "@llvm-analyzer/parser": "workspace:*",
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.27.2",
    "mocha": "^11.7.5"
  },
  "contributes": {
    "languages": [
      {
        "id": "llvm",
        "aliases": [
          "LLVM IR",
          "llvm"
        ],
        "extensions": [
          ".ll"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "llvm",
        "scopeName": "source.llvm",
        "path": "./syntaxes/llvm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "llvm-analyzer.showControlFlowGraph",
        "title": "LLVM IR: Show Control Flow Graph"
      }
    ],
    "configuration": {
      "title": "LLVM IR",
      "properties": {
        "llvm-analyzer.verifier.enabled": {
          "type": "boolean",
          "default": true,
          "description": "PATH 上の LLVM verifier を使った追加診断を有効にする。"
        },
        "llvm-analyzer.verifier.command": {
          "type": "string",
          "default": "llvm-as",
          "description": "LLVM verifier として実行するコマンド。"
        },
        "llvm-analyzer.verifier.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-o",
            "{devNull}",
            "-"
          ],
          "description": "verifier コマンドへ渡す引数。`{devNull}` は OS の null device に置換される。"
        },
        "llvm-analyzer.verifier.debounceMs": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "編集停止後に LLVM verifier を起動するまでの待ち時間（ミリ秒）。"
        },
        "llvm-analyzer.verifier.timeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "description": "LLVM verifier の実行を打ち切るまでの時間（ミリ秒）。"
        },
        "llvm-analyzer.verifier.maxFileBytes": {
          "type": "number",
          "default": 1000000,
          "minimum": 0,
          "description": "自動 verifier を実行する最大ファイルサイズ（UTF-8 バイト数）。"
        },
        "llvm-analyzer.diagnostics.parser.enabled": {
          "type": "boolean",
          "default": true,
          "description": "parser 由来の構文診断を有効にする。"
        },
        "llvm-analyzer.diagnostics.parser.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "error",
          "description": "parser 由来の構文診断の重大度。"
        },
        "llvm-analyzer.diagnostics.analyzer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "analyzer 由来の意味診断を有効にする。"
        },
        "llvm-analyzer.diagnostics.analyzer.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "error",
          "description": "analyzer 由来の意味診断の重大度。"
        },
        "llvm-analyzer.diagnostics.verifier.enabled": {
          "type": "boolean",
          "default": true,
          "description": "外部 verifier 由来の診断を有効にする。無効時は verifier プロセスも起動しない。"
        },
        "llvm-analyzer.diagnostics.verifier.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "error",
          "description": "外部 verifier 由来の診断の重大度。"
        },
        "llvm-analyzer.inlayHints.types.enabled": {
          "type": "boolean",
          "default": true,
          "description": "SSA 値の推定型を inlay hint として表示する。"
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:llvm-analyzer.showControlFlowGraph",
    "onLanguage:llvm"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "LLVM verifier command settings can execute external tools, so this extension requires a trusted workspace."
    }
  }
}
